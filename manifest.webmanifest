{
  "name": "PBM Kuva + sanelu",
  "short_name": "Kuva + sanelu",
  "lang": "fi",
  "id": "./index.html",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f2ec",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "prefer_related_applications": false,
  "share_target": {
    "action": "./jaa",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "otsikko",
      "text": "teksti",
      "files": [
        {
          "name": "tiedostot",
          "accept": [
            "application/zip",
            "application/x-zip-compressed",
            ".zip",
            "application/json",
            ".json",
            "application/pdf",
            ".pdf",
            "image/*"
          ]
        }
      ]
    }
  }
}
